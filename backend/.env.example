# Postgres connection (Supabase Postgres). Local default below.
# Production: pull host/password/port from your Supabase project.
DATABASE_URL=postgres://postgres:postgres@host.docker.internal:54322/postgres

# Preferred: validate access tokens via GoTrue (same as Supabase JS client).
# Base URL must reach /auth/v1 from this container (public https or host.docker.internal:54321).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Fallback only if SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY unset: HS256 decode.
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Telegram bot token, used by /auth/telegram (initData + login widget validation)
TELEGRAM_BOT_TOKEN=

# Comma-separated list of allowed CORS origins for the SPA
CORS_ORIGINS=https://obshak.space,http://localhost:8080,http://localhost:5173

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
